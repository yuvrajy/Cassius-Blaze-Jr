# Copy to `.env.local` and fill in. None of these have safe defaults — all
# must be set before the agents that consume them can run their own code.
#
# Owner column = which sub-agent first reads this var.

# === Supabase (everyone) ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# === Domains (agent 1, baked into middleware + contracts) ==========
NEXT_PUBLIC_HUB_DOMAIN=thenorm.info
NEXT_PUBLIC_PARENT_DOMAIN=iam.bio
NEXT_PUBLIC_SERVICE_DOMAIN=getknown.com

# === Stripe (agent 6) ==============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (NOT amounts). Create in the Stripe dashboard and paste
# their `price_…` ids here. Both must be set for the signup endpoint.
STRIPE_PRICE_BASE=
STRIPE_PRICE_BESPOKE_DOMAIN=

# === Resend — transactional email (agent 6) ========================
RESEND_API_KEY=
# Display sender for transactional email. Must be a Resend-verified domain.
EMAIL_FROM="The Norm <hello@thenorm.info>"

# === Inngest — workflows (agent 6) =================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# === Anthropic — Claude article generation + bio review ============
# (agent 2 uses for live preview; agent 6 uses for generation)
ANTHROPIC_API_KEY=

# === Photo moderation (agent 6) ====================================
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=

# === Google APIs ===================================================
# CSE: name-uniqueness lookup. Agent 2 uses live; agent 6 caches in
# name_collision_checks.
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# === Porkbun — bespoke domain registration (agent 7) ===============
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# === Vercel — used by agent 7 to attach bespoke domains via API ====
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Optional. Set when the Vercel project lives under a team (token must
# have team scope). Empty for personal projects.
VERCEL_TEAM_ID=

# === Cron auth (agent 7) ===========================================
# Bearer token sent by Vercel Cron / external scheduler. Agent 7 verifies
# this in app/api/cron/* before running anything destructive.
CRON_SECRET=
# Days a profile sits in 'taken_down' before agent 7's cron hard-deletes
# its assets and anonymizes the row. Default 30. Set lower in dev.
TAKEDOWN_COOLING_DAYS=30

# === Admin allow-list (agent 5) ====================================
# Comma-separated email addresses that can access /admin. Membership is
# checked server-side by lib/auth.ts:requireAdmin().
ADMIN_EMAILS=

# === Dev-mode flags (agent 6) ======================================
# Set DEV_MODE_LOG_ONLY=1 to short-circuit ALL external API calls
# (Stripe, Resend, Sightengine, TinEye, Anthropic). The signup pipeline
# will run end-to-end against a Supabase dev instance with no third-party
# credentials — payloads log to stderr instead of hitting the network.
# Granular flags below opt in/out per vendor when you have keys for some
# but not others.
DEV_MODE_LOG_ONLY=
DEV_STRIPE_LOG_ONLY=
DEV_RESEND_LOG_ONLY=
DEV_SIGHTENGINE_LOG_ONLY=
DEV_TINEYE_LOG_ONLY=
DEV_ANTHROPIC_LOG_ONLY=
DEV_INNGEST_LOG_ONLY=
