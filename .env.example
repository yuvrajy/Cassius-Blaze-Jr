# Copy to .env.local and fill in. .env.local is gitignored.

# ─────────────────────────────────────────────────────────────────
# REQUIRED FOR LAUNCH
# ─────────────────────────────────────────────────────────────────

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Domains ---
NEXT_PUBLIC_HUB_DOMAIN=thenorm.info
NEXT_PUBLIC_PARENT_DOMAIN=mybio.cloud
NEXT_PUBLIC_SERVICE_DOMAIN=theplaybook.site

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASE=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="The Playbook <onboarding@resend.dev>"

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Cron + admin ---
CRON_SECRET=
ADMIN_EMAILS=
TAKEDOWN_COOLING_DAYS=30


# ─────────────────────────────────────────────────────────────────
# SKIP FOR V1 (leave blank — code stubs gracefully)
# ─────────────────────────────────────────────────────────────────

# Photo moderation — admin reviews manually until you turn these on
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=

# Name uniqueness via Google — Wikipedia + Claude work fine without
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# Bespoke domain upsell — only if you sell the bespoke tier
STRIPE_PRICE_BESPOKE_DOMAIN=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=


# ─────────────────────────────────────────────────────────────────
# DEV MODE — short-circuit external API calls
# ─────────────────────────────────────────────────────────────────
# DEV_MODE_LOG_ONLY=1 stubs ALL external services (Stripe, Resend,
# Sightengine, TinEye, Anthropic, Inngest). Per-vendor flags below
# let you opt in/out individually.

DEV_MODE_LOG_ONLY=
DEV_STRIPE_LOG_ONLY=
DEV_RESEND_LOG_ONLY=
DEV_SIGHTENGINE_LOG_ONLY=
DEV_TINEYE_LOG_ONLY=
DEV_ANTHROPIC_LOG_ONLY=
DEV_INNGEST_LOG_ONLY=
