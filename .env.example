# Copy to `.env.local` and fill in. None of these have safe defaults — all
# must be set before the agents that consume them can run their own code.
#
# Owner column = which sub-agent first reads this var.

# === Supabase (everyone) ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# === Domains (agent 1, baked into middleware + contracts) ==========
NEXT_PUBLIC_HUB_DOMAIN=thenorm.info
NEXT_PUBLIC_PARENT_DOMAIN=iam.bio
NEXT_PUBLIC_SERVICE_DOMAIN=getknown.com

# === Stripe (agent 6) ==============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === Resend — transactional email (agent 6) ========================
RESEND_API_KEY=

# === Inngest — workflows (agent 6) =================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# === Anthropic — Claude article generation + bio review ============
# (agent 2 uses for live preview; agent 6 uses for generation)
ANTHROPIC_API_KEY=

# === Photo moderation (agent 6) ====================================
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=

# === Google APIs ===================================================
# CSE: name-uniqueness lookup. Agent 2 uses live; agent 6 caches in
# name_collision_checks.
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# === Porkbun — bespoke domain registration (agent 7) ===============
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# === Vercel — used by agent 7 to attach bespoke domains via API ====
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# === Cron auth (agent 7) ===========================================
# Bearer token sent by Vercel Cron / external scheduler. Agent 7 verifies
# this in app/api/cron/* before running anything destructive.
CRON_SECRET=
